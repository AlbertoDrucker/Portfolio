---
import type { Lang } from '../../i18n/ui';
import { marketSizing } from '../../content/tools/market-sizing';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = marketSizing[lang];
const p = c.presets[0];
---

<div class="tool ms" data-tool="market-sizing" data-lang={lang} data-copy={JSON.stringify({ ...c.dyn, presets: c.presets })}>
  <div class="tool-grid">
    <div class="tool-inputs">
      <div class="field">
        <span class="field-label">{c.presetsLabel}</span>
        <div class="seg stack" data-presets>
          {
            c.presets.map((pr, i) => (
              <button type="button" data-preset={pr.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {pr.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="field">
        <span class="field-label">{c.currency}</span>
        <div class="seg" data-currency>
          <button type="button" data-cur="MXN" aria-pressed="true">MXN</button>
          <button type="button" data-cur="USD" aria-pressed="false">USD</button>
        </div>
      </div>
      <label class="field">
        <span class="field-label">{c.buyers}</span>
        <input type="number" name="buyers" min="0" step="1000" value={p.buyers} inputmode="numeric" />
        <span class="tool-hint">{c.buyersHint}</span>
      </label>
      <label class="field">
        <span class="field-label">{c.fit}<span class="field-value" data-out="fit"></span></span>
        <input type="range" name="fit" min="1" max="100" step="1" value={p.fit} />
        <span class="tool-hint">{c.fitHint}</span>
      </label>
      <label class="field">
        <span class="field-label">{c.reach}<span class="field-value" data-out="reach"></span></span>
        <input type="range" name="reach" min="1" max="100" step="1" value={p.reach} />
        <span class="tool-hint">{c.reachHint}</span>
      </label>
      <label class="field">
        <span class="field-label">{c.freq}</span>
        <input type="number" name="freq" min="0" step="1" value={p.freq} inputmode="decimal" />
      </label>
      <label class="field">
        <span class="field-label">{c.price}</span>
        <input type="number" name="price" min="0" step="1" value={p.price} inputmode="decimal" />
      </label>
      <label class="field">
        <span class="field-label">{c.share}<span class="field-value" data-out="share"></span></span>
        <input type="range" name="share" min="0.1" max="30" step="0.1" value={p.share} />
        <span class="tool-hint">{c.shareHint}</span>
      </label>
    </div>

    <div class="tool-outputs">
      <div class="stats">
        <div class="stat"><span class="stat-label">{c.tam} <span class="muted">({c.tamSub})</span></span><span class="stat-value" data-out="tam">–</span></div>
        <div class="stat"><span class="stat-label">{c.sam} <span class="muted">({c.samSub})</span></span><span class="stat-value" data-out="sam">–</span></div>
        <div class="stat"><span class="stat-label">{c.som} <span class="muted">({c.somSub})</span></span><span class="stat-value" data-out="som">–</span></div>
        <div class="stat"><span class="stat-label">{c.customers}</span><span class="stat-value" data-out="customers">–</span></div>
      </div>

      <div class="ms-viz">
        <svg class="ms-squares" data-squares viewBox="0 0 320 320" role="img" aria-label={c.dyn.squaresLabel}></svg>
        <div class="ms-chain">
          <p class="tool-section-title">{c.chainTitle}</p>
          <p class="ms-chain-text" data-out="chain"></p>
        </div>
      </div>

      <div class="ms-believe">
        <p class="tool-section-title">{c.believeTitle}</p>
        <label class="field ms-goal">
          <span class="field-label">{c.goal}</span>
          <input type="number" name="goal" min="0" step="100000" value={p.goal} inputmode="numeric" />
        </label>
        <p class="ms-believe-text" data-out="believe"></p>
        <p class="verdict" data-verdict></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { initTools } from '../../scripts/tools/util';
  import { setupMarketSizing } from '../../scripts/tools/market-sizing';
  initTools('[data-tool="market-sizing"]', setupMarketSizing);
</script>

<style>
  .ms-viz {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .ms-squares {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  :global(.ms-squares .sq-tam) {
    fill: var(--ink-raised);
    stroke: var(--rule-strong);
  }

  :global(.ms-squares .sq-sam) {
    fill: #dfe3f3;
    stroke: var(--stone);
  }

  :global(.ms-squares .sq-som) {
    fill: var(--paper);
  }

  :global(.ms-squares text) {
    font-family: var(--sans);
    font-size: 12px;
    fill: var(--stone);
  }

  :global(.ms-squares .sq-label-strong) {
    fill: var(--paper);
  }

  .ms-chain-text {
    margin-top: 0.5rem;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--paper);
  }

  .ms-believe {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .ms-goal {
    max-width: 280px;
  }

  .ms-believe-text {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 52ch;
  }

  @media (min-width: 720px) {
    .ms-viz {
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      column-gap: 2rem;
    }
  }
</style>
