---
import type { Lang } from '../../i18n/ui';
import { aiWorkflowBuilder } from '../../content/tools/ai-workflow-builder';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = aiWorkflowBuilder[lang];
const payload = { ...c.dyn, templates: c.templates, owners: c.owners, critical: c.critical, laneAi: c.laneAi, lanePerson: c.lanePerson };
---

<div class="tool" data-tool="ai-workflow-builder" data-lang={lang} data-copy={JSON.stringify(payload)}>
  <div class="tool-grid">
    <div class="tool-inputs">
      <div class="field">
        <span class="field-label">{c.templateLabel}</span>
        <div class="seg stack" data-templates>
          {c.templates.map((t, i) => <button type="button" data-template={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
        </div>
      </div>
      <p class="tool-section-title">{c.stepsTitle}</p>
      <ol class="wf-steps" data-steps></ol>
    </div>

    <div class="tool-outputs">
      <div class="stats">
        <div class="stat"><span class="stat-label">{c.timeBefore}</span><span class="stat-value" data-out="before">–</span></div>
        <div class="stat"><span class="stat-label">{c.timeAfter}</span><span class="stat-value" data-out="after">–</span></div>
        <div class="stat"><span class="stat-label">{c.saved}</span><span class="stat-value" data-out="saved">–</span></div>
        <div class="stat"><span class="stat-label">{c.coverage}</span><span class="stat-value" data-out="coverage">–</span></div>
      </div>
      <p class="verdict" data-verdict></p>
      <figure class="wf-fig">
        <figcaption class="tool-section-title">{c.flowTitle}</figcaption>
        <div class="wf-lanes" data-lanes role="img" aria-label={c.dyn.flowAria}></div>
      </figure>
    </div>
  </div>
</div>

<script>
  import { initTools } from '../../scripts/tools/util';
  import { setupWorkflowBuilder } from '../../scripts/tools/ai-workflow-builder';
  initTools('[data-tool="ai-workflow-builder"]', setupWorkflowBuilder);
</script>

<style>
  .wf-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  :global(.wf-step) {
    display: grid;
    gap: 0.45rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  :global(.wf-step-name) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
    color: var(--paper);
  }

  :global(.wf-flag) {
    font-size: 0.75rem;
    color: var(--judgment);
    border: 1px solid rgba(168, 84, 0, 0.45);
    border-radius: 999px;
    padding: 0 0.45rem;
  }

  :global(.wf-step .seg button) {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
  }

  .wf-fig {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .wf-lanes {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  :global(.wf-grid) {
    display: grid;
    grid-template-rows: auto auto;
    gap: 0.5rem;
    min-width: 560px;
  }

  :global(.wf-lane-label) {
    font-size: 0.8rem;
    color: var(--stone);
    align-self: center;
  }

  :global(.wf-cell) {
    min-height: 4.2rem;
    border-radius: 4px;
    border: 1px dashed var(--rule);
    padding: 0.5rem 0.6rem;
    font-size: 0.8rem;
    line-height: 1.3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.25rem;
  }

  :global(.wf-cell.ai) {
    border: 1px solid rgba(43, 71, 245, 0.5);
    background: var(--ai-soft);
  }

  :global(.wf-cell.person) {
    border: 1px solid rgba(168, 84, 0, 0.55);
    background: var(--judgment-soft);
  }

  :global(.wf-cell.check) {
    border: 1px solid rgba(168, 84, 0, 0.4);
    background: transparent;
    color: var(--judgment);
  }

  :global(.wf-cell.gap) {
    border-color: var(--bad);
  }

  :global(.wf-cell small) {
    color: var(--stone);
    font-size: 0.75rem;
  }
</style>
