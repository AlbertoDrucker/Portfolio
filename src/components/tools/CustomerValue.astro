---
import type { Lang } from '../../i18n/ui';
import { customerValue } from '../../content/tools/customer-value';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = customerValue[lang];
---

<div class="tool" data-tool="customer-value" data-lang={lang} data-copy={JSON.stringify(c.dyn)}>
  <div class="tool-grid">
    <div class="tool-inputs">
      <div class="field">
        <span class="field-label">{c.currency}</span>
        <div class="seg" data-currency>
          <button type="button" data-cur="MXN" aria-pressed="true">MXN</button>
          <button type="button" data-cur="USD" aria-pressed="false">USD</button>
        </div>
      </div>
      <label class="field">
        <span class="field-label">{c.aov}</span>
        <input type="number" name="aov" min="0" step="10" value="850" inputmode="decimal" />
      </label>
      <label class="field">
        <span class="field-label">{c.orders}</span>
        <input type="number" name="orders" min="0" step="0.5" value="6" inputmode="decimal" />
      </label>
      <label class="field">
        <span class="field-label">{c.margin}<span class="field-value" data-out="margin"></span></span>
        <input type="range" name="margin" min="5" max="90" step="1" value="45" />
      </label>
      <label class="field">
        <span class="field-label">{c.retention}<span class="field-value" data-out="retention"></span></span>
        <input type="range" name="retention" min="10" max="97" step="1" value="70" />
        <span class="tool-hint">{c.retentionHint}</span>
      </label>
      <label class="field">
        <span class="field-label">{c.discount}<span class="field-value" data-out="discount"></span></span>
        <input type="range" name="discount" min="0" max="25" step="1" value="12" />
        <span class="tool-hint">{c.discountHint}</span>
      </label>
      <label class="field">
        <span class="field-label">{c.cac}</span>
        <input type="number" name="cac" min="0" step="50" value="2400" inputmode="decimal" />
      </label>
    </div>

    <div class="tool-outputs">
      <div class="stats">
        <div class="stat"><span class="stat-label">{c.clv}</span><span class="stat-value" data-out="clv">–</span></div>
        <div class="stat"><span class="stat-label">{c.ratio}</span><span class="stat-value" data-out="ratio">–</span></div>
        <div class="stat"><span class="stat-label">{c.payback}</span><span class="stat-value" data-out="payback">–</span></div>
        <div class="stat"><span class="stat-label">{c.lifetime}</span><span class="stat-value" data-out="life">–</span></div>
      </div>
      <p class="verdict" data-verdict></p>

      <figure class="cv-fig">
        <figcaption class="tool-section-title">{c.chart1}</figcaption>
        <svg class="chart" data-chart1></svg>
        <p class="legend-row">
          <span style="color: var(--paper)"><i></i>{c.legendValue}</span>
          <span style="color: var(--stone)"><i></i>{c.legendCac}</span>
        </p>
      </figure>

      <figure class="cv-fig">
        <figcaption class="tool-section-title">{c.chart2}</figcaption>
        <svg class="chart" data-chart2></svg>
        <p class="cv-lever" data-out="lever"></p>
      </figure>
    </div>
  </div>
</div>

<script>
  import { initTools } from '../../scripts/tools/util';
  import { setupCustomerValue } from '../../scripts/tools/customer-value';
  initTools('[data-tool="customer-value"]', setupCustomerValue);
</script>

<style>
  .cv-fig {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .cv-lever {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.5;
    max-width: 58ch;
  }
</style>
