---
import type { Lang } from '../../i18n/ui';
import { rentalOps } from '../../content/tools/rental-ops';
import { rentalExt } from '../../content/tools/rental-ext';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = rentalOps[lang];
---

<div class="tool app" data-tool="rental-ops" data-lang={lang} data-copy={JSON.stringify({ ...c, ext: rentalExt[lang] })} data-own-state>
  <div data-app>
    <div class="app-body">
      <h2>{c.approveTitle}</h2>
      <p class="app-sub">{c.approveLead}</p>
    </div>
  </div>
</div>

<script>
  import { initTools } from '../../scripts/tools/util';
  import { setupRentalOps } from '../../scripts/tools/rental-ops';
  initTools('[data-tool="rental-ops"]', setupRentalOps);
</script>

<style is:global>
  .rops-dl {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }

  .rops-dl dt {
    font-size: 0.78rem;
    color: var(--stone);
    margin-top: 0.5rem;
  }

  .rops-dl dd {
    margin: 0;
  }

  .rops-apps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.75rem var(--tool-pad) 0;
  }

  .rops-apps button {
    font: 500 0.9rem var(--sans);
    color: var(--paper);
    background: var(--ink-raised);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    cursor: pointer;
  }

  .rops-apps button[aria-pressed='true'] {
    background: var(--paper);
    border-color: var(--paper);
    color: #fff;
  }

  :global(.rops-live) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    font: 500 0.92rem var(--sans);
    color: var(--paper);
  }

  .rops-hello {
    font-family: var(--serif);
    font-size: 1.2rem;
  }

  .rops-big {
    font-family: var(--display);
    font-size: 2.4rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .rops-statement {
    max-width: 62ch;
    padding: 1rem 1.2rem;
    border-radius: 14px;
    background: var(--judgment-soft);
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .rops-agree {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
</style>
