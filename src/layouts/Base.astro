---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource/caveat/500.css';
import '../styles/global.css';
import { localePath, otherLang, useStrings, type Lang, type PageSlug } from '../i18n/ui';
import { contact } from '../content/site';

interface Props {
  lang: Lang;
  slug: PageSlug | string;
  title: string;
  description: string;
  /** Share image path under public/og, defaults to one made for this page. */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** Extra structured data for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, slug, title, description, type = 'website', schema = [], noindex = false } = Astro.props;
const t = useStrings(lang);
const alt = otherLang(lang);
const site = Astro.site ?? new URL('https://adrucker.vercel.app');
const canonical = new URL(localePath(lang, slug), site).href;
const altHref = new URL(localePath(alt, slug), site).href;
const enHref = new URL(localePath('en', slug), site).href;
const ogSlug = String(slug).replace(/\/$/, '').replace(/\//g, '-') || 'home';
const image = new URL(Astro.props.image ?? `/og/${lang}/${ogSlug}.jpg`, site).href;
const siteUrl = new URL(localePath(lang), site).href;
const person = {
  '@type': 'Person',
  '@id': `${site.href}#alberto`,
  name: 'Alberto Drucker',
  url: siteUrl,
  jobTitle: lang === 'es' ? 'Estratega de marketing, producto e innovación' : 'Strategy, product marketing and innovation',
  homeLocation: { '@type': 'Place', name: lang === 'es' ? 'Monterrey, Nuevo León, México' : 'Monterrey, Nuevo León, Mexico' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Tecnológico de Monterrey' },
    { '@type': 'CollegeOrUniversity', name: 'Indiana University Kelley School of Business' },
  ],
  knowsAbout: ['Corporate strategy', 'Strategic planning', 'Product marketing', 'Innovation', 'Go to market', 'Applied AI', 'Customer research'],
  knowsLanguage: ['es', 'en'],
  sameAs: [contact.linkedin],
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    { '@type': 'WebSite', '@id': `${site.href}#site`, name: 'Alberto Drucker', url: site.href, inLanguage: ['en', 'es-MX'], publisher: { '@id': `${site.href}#alberto` } },
    { '@type': 'WebPage', name: title, description, url: canonical, inLanguage: lang === 'es' ? 'es-MX' : 'en', isPartOf: { '@id': `${site.href}#site` }, about: { '@id': `${site.href}#alberto` }, primaryImageOfPage: image },
    ...schema,
  ],
};

const nav: { slug: PageSlug; label: string }[] = [
  { slug: 'lab', label: t.nav.lab },
  { slug: 'how-i-work', label: t.nav.howIWork },
  { slug: 'work', label: t.nav.work },
  { slug: 'about', label: t.nav.about },
];
---

<!doctype html>
<html lang={lang === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'es-MX' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={alt === 'es' ? 'es-MX' : 'en'} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta name="theme-color" content="#f3f5ef" />
    <meta name="author" content="Alberto Drucker" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Alberto Drucker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={localePath(lang)} aria-current={slug === '' ? 'page' : undefined}>{t.siteName}</a>
        <nav class="site-nav" aria-label={t.nav.label}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={localePath(lang, item.slug)} aria-current={slug === item.slug ? 'page' : String(slug).startsWith(item.slug + '/') ? 'true' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="lang" href={localePath(alt, slug)} hreflang={alt} lang={alt} aria-label={t.switchLangLabel}>
          {t.switchLang}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="wrap footer-inner">
        <div class="footer-contact">
          <h2 class="footer-title">{t.footer.contactTitle}</h2>
          <p class="footer-lead">{t.footer.contactLead}</p>
          <p class="footer-links">
            {contact.booking && <a class="footer-btn" href={contact.booking} rel="noopener">{t.footer.form.book}</a>}
            {contact.linkedin && <a class="footer-btn quiet" href={contact.linkedin} rel="me noopener">{t.footer.form.linkedin}</a>}
          </p>
        </div>
        <form
          class="contact-form"
          data-contact
          data-key={contact.formKey}
          data-sending={t.footer.form.sending}
          data-success={t.footer.form.success}
          data-error={t.footer.form.error}
          data-pending={t.footer.form.pending}
        >
          <div class="cf-row">
            <label class="cf-field"><span>{t.footer.form.name}</span><input type="text" name="name" autocomplete="name" required /></label>
            <label class="cf-field"><span>{t.footer.form.email}</span><input type="email" name="email" autocomplete="email" required /></label>
          </div>
          <label class="cf-field">
            <span>{t.footer.form.topic}</span>
            <select name="topic">{t.footer.form.topics.map((x) => <option>{x}</option>)}</select>
          </label>
          <label class="cf-field"><span>{t.footer.form.message}</span><textarea name="message" rows="4" required></textarea></label>
          <input type="checkbox" name="botcheck" class="cf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="cf-actions">
            <button type="submit" class="footer-btn">{t.footer.form.send}</button>
            <p class="cf-status" data-status role="status">{t.footer.form.privacy}</p>
          </div>
        </form>
        <div class="footer-meta">
          <p>{t.footer.location}</p>
          <p>{t.footer.built}</p>
        </div>
      </div>
    </footer>
    <script>
      import { initContact } from '../scripts/contact';
      initContact();
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
    font-family: var(--sans);
    font-size: 0.95rem;
  }

  .brand {
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.005em;
    margin-right: auto;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.6rem;
  }

  .site-nav a,
  .lang {
    text-decoration: none;
    color: var(--stone);
  }

  .site-nav a:hover,
  .lang:hover,
  .site-nav a[aria-current] {
    color: var(--paper);
  }

  .lang {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.875rem;
  }

  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: wrap;
      row-gap: 0.25rem;
      padding-block: 0.85rem;
    }

    .site-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
    }

    .site-nav ul {
      gap: 1.15rem;
      white-space: nowrap;
      padding-block: 0.35rem;
    }
  }

  .site-footer {
    background: var(--paper);
    color: #fff;
    padding-block: clamp(3.5rem, 8vw, 6rem) 2.5rem;
  }

  .site-footer :global(a) {
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }

  .site-footer :global(:focus-visible) {
    outline-color: #fff;
  }

  .footer-inner {
    display: grid;
    gap: 3rem;
  }

  .footer-title {
    font-size: var(--step-3);
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 72;
  }

  .footer-lead {
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.86);
    max-width: 44ch;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-size: 1.05rem;
  }

  .footer-btn {
    display: inline-block;
    font: 600 1rem var(--sans);
    color: var(--paper);
    background: var(--judgment-mark);
    border: 1px solid var(--judgment-mark);
    border-radius: 999px;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    cursor: pointer;
  }

  .footer-btn:hover {
    background: #fff;
    border-color: #fff;
    color: var(--paper);
  }

  .footer-btn.quiet {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }

  .contact-form {
    display: grid;
    gap: 0.9rem;
    font-family: var(--sans);
    max-width: 34rem;
  }

  .cf-row {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 560px) {
    .cf-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cf-field {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
  }

  .cf-field input,
  .cf-field select,
  .cf-field textarea {
    width: 100%;
    font: 1rem var(--sans);
    color: var(--paper);
    background: #fff;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
  }

  .cf-field textarea {
    resize: vertical;
    line-height: 1.45;
  }

  .cf-hp {
    display: none;
  }

  .cf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .cf-status {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 30ch;
  }

  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      column-gap: 4rem;
    }

    .footer-meta {
      grid-column: 1 / -1;
    }
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.86);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  @media print {
    .site-header,
    .site-footer,
    .skip-link {
      display: none;
    }
  }
</style>
