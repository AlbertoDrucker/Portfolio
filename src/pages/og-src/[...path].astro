---
/**
 * Source pages for the share images. They only exist when OG=1 is set, so they never ship.
 * scripts/og.mjs screenshots each one at 1200x630 into public/og/<lang>/<slug>.jpg.
 */
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource/caveat/500.css';
import type { Lang } from '../../i18n/ui';
import { home, howIWork, work, about } from '../../content/site';
import { labPage, labProjects } from '../../content/lab';
import { caseStudies } from '../../content/cases';
import { caseExtras } from '../../content/case-extras';
import { ogCopy } from '../../content/og';

interface Card {
  kicker: string;
  title: string;
  note: string;
  stat?: string;
  big?: boolean;
  lines?: string[];
}

export function getStaticPaths() {
  if (!process.env.OG) return [];
  const out: { params: { path: string }; props: { lang: Lang; card: Card } }[] = [];
  for (const lang of ['en', 'es'] as Lang[]) {
    const o = ogCopy[lang];
    const add = (slug: string, card: Card) => out.push({ params: { path: `${lang}/${slug}` }, props: { lang, card } });
    add('home', { kicker: o.homeKicker, title: home[lang].heroLines.join(' '), lines: home[lang].heroLines, note: home[lang].heroNote, big: true });
    add('lab', { kicker: labPage[lang].title, title: labPage[lang].metaTitle.split(' | ')[0], note: o.labNote });
    add('how-i-work', { kicker: howIWork[lang].title, title: howIWork[lang].metaDescription.split(':')[0], note: o.howNote });
    add('work', { kicker: work[lang].title, title: work[lang].metaTitle.split(' | ')[0], note: o.workNote });
    add('about', { kicker: about[lang].title, title: about[lang].lead, note: o.aboutNote });
    for (const s of caseStudies[lang]) {
      const x = caseExtras[lang][s.id];
      add(`work-${s.id}`, { kicker: s.area, title: s.title, note: x.live ? o.tryNote : o.caseNote, stat: x.cover });
    }
    for (const p of labProjects) {
      add(`lab-${p.slug}`, { kicker: labPage[lang].categories[p.category], title: p.copy[lang].title, note: o.labNote });
    }
  }
  return out;
}

const { lang, card } = Astro.props;
const o = ogCopy[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <style>
      html, body { margin: 0; }
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #0f2a1f;
        color: #fff;
        font-family: 'Archivo Variable', sans-serif;
      }
      .card {
        position: relative;
        box-sizing: border-box;
        width: 1200px;
        height: 630px;
        padding: 64px 72px 56px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: 28px;
      }
      .grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(212, 245, 106, 0.13) 1.6px, transparent 1.7px);
        background-size: 28px 28px;
        mask-image: linear-gradient(115deg, transparent 35%, #000 100%);
      }
      .kicker {
        position: relative;
        font: 600 26px/1.2 'Archivo Variable', sans-serif;
        color: #d4f56a;
      }
      .title {
        position: relative;
        align-self: center;
        margin: 0;
        font: 500 66px/1.04 'Bricolage Grotesque Variable', sans-serif;
        letter-spacing: -0.03em;
        max-width: 980px;
        text-wrap: balance;
      }
      .big .title { font-size: 92px; max-width: 1060px; }
      .line { display: block; }
      .l1 { color: #d4f56a; }
      .who { flex: none; }
      .title.long { font-size: 54px; }
      .stat {
        display: inline-block;
        margin-top: 26px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #5b3df5;
        font: 600 26px/1.2 'Archivo Variable', sans-serif;
        letter-spacing: 0;
      }
      .foot {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 32px;
      }
      .who { display: grid; gap: 6px; }
      .name { font: 600 30px/1.1 'Bricolage Grotesque Variable', sans-serif; }
      .meta { font: 500 21px/1.3 'Archivo Variable', sans-serif; color: #c7d3cc; }
      .note {
        font: 500 40px/1.1 'Caveat', cursive;
        color: #0f2a1f;
        background: #d4f56a;
        padding: 6px 20px 10px;
        border-radius: 6px 16px 8px 18px;
        rotate: -2.5deg;
        white-space: nowrap;
      }
      .mark {
        position: absolute;
        right: 72px;
        top: 56px;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: #d4f56a;
        color: #0f2a1f;
        display: grid;
        place-items: center;
        font: 600 26px 'Bricolage Grotesque Variable', sans-serif;
        letter-spacing: -0.04em;
      }
    </style>
  </head>
  <body>
    <div class={`card${card.big ? ' big' : ''}`}>
      <div class="grid"></div>
      <div class="kicker">{card.kicker}</div>
      <div>
        <h1 class={`title${card.title.length > 70 ? ' long' : ''}`}>{card.lines ? card.lines.map((l, i) => <span class={`line l${i}`}>{l}</span>) : card.title}</h1>
        {card.stat && <span class="stat">{card.stat}</span>}
      </div>
      <div class="foot">
        <div class="who">
          <span class="name">Alberto Drucker</span>
          <span class="meta">{o.role}</span>
          <span class="meta">{o.place}</span>
        </div>
        <span class="note">{card.note}</span>
      </div>
      <div class="mark">ad</div>
    </div>
  </body>
</html>
