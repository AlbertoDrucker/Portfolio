---
import Base from '../layouts/Base.astro';
import { localePath } from '../i18n/ui';
import { notFound } from '../content/notfound';

const e = notFound.en;
const s = notFound.es;
---

<Base lang="en" slug="" title={`${e.title} | Alberto Drucker`} description={e.text} noindex>
  <section class="page-hero wrap nf">
    <h1 class="page-title">{e.title}</h1>
    <p>{e.text}</p>
    <p class="nf-links">
      <a class="text-link" href={localePath('en')}>{e.home}</a>
      <a class="text-link" href={localePath('en', 'lab')}>{e.lab}</a>
      <a class="text-link" href={localePath('en', 'work')}>{e.work}</a>
    </p>
    <div lang="es">
      <h2>{s.title}</h2>
      <p class="nf-links">
        <a class="text-link" href={localePath('es')}>{s.home}</a>
        <a class="text-link" href={localePath('es', 'lab')}>{s.lab}</a>
        <a class="text-link" href={localePath('es', 'work')}>{s.work}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
    display: grid;
    gap: 1.25rem;
  }

  .nf h2 {
    font: 500 1.6rem var(--display);
    margin: 1.5rem 0 0;
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
