---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/ui';
import { about } from '../content/site';
import fs from 'node:fs';
import path from 'node:path';

/** Photos live in public/about/<key>.webp. A missing file shows a marked empty frame. */
const photo = (key: string) => (fs.existsSync(path.join(process.cwd(), 'public/about', `${key}.webp`)) ? `/about/${key}.webp` : null);

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = about[lang];
---

<Base lang={lang} slug="about" title={c.metaTitle} description={c.metaDescription}>
  <section class="page-hero wrap about-hero">
    <div class="about-hero-text">
      <h1 class="page-title">{c.title}</h1>
      <p class="page-lead">{c.lead}</p>
    </div>
    <figure class="portrait">
      {photo('portrait') ? <img src={photo('portrait')} alt={c.portraitAlt} width="900" height="1125" /> : <span class="photo-empty">{c.photoSoon}</span>}
    </figure>
  </section>

  <section class="wrap about-body">
    <div class="prose about-prose">
      {c.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="focus">
      <h2 class="focus-title">{c.pathTitle}</h2>
      <ol class="path">
        {c.path.map((x) => <li><strong>{x.title}</strong><span>{x.text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="wrap outside">
    <h2 class="focus-title">{c.outsideTitle}</h2>
    <ul class="outside-grid">
      {
        c.outside.map((o) => (
          <li>
            <figure>
              <div class="outside-photo">{photo(o.key) ? <img src={photo(o.key)} alt={o.label} width="800" height="1000" loading="lazy" /> : <span class="photo-empty">{c.photoSoon}</span>}</div>
              <figcaption>{o.label}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">{c.focusTitle}</h2>
      <ul class="pillars">
        {c.focus.map((f) => <li><strong>{f.title}</strong><span>{f.text}</span></li>)}
      </ul>
      <p class="about-cta"><a class="cta-pill" href="#contact">{c.cta}</a></p>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    align-items: end;
  }

  @media (min-width: 860px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .about-hero-text {
    display: grid;
    gap: 1.25rem;
  }

  .portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    border-radius: 18px;
    overflow: hidden;
    background: var(--ink-raised);
    box-shadow: var(--lift);
    rotate: 1.2deg;
  }

  .portrait img,
  .outside-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-empty {
    display: grid;
    place-items: center;
    height: 100%;
    font: 600 0.95rem var(--sans);
    color: var(--stone);
    border: 2px dashed var(--rule);
    border-radius: inherit;
  }

  .outside {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .outside-grid {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 860px) {
    .outside-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .outside-grid figure {
    margin: 0;
  }

  .outside-photo {
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    background: var(--ink-raised);
  }

  .outside-grid figcaption {
    font: 500 0.95rem / 1.35 var(--sans);
    color: var(--stone);
    margin-top: 0.6rem;
  }

  .page-hero {
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.028em;
    font-weight: 360;
    font-variation-settings: 'opsz' 72;
  }

  .page-lead {
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.25;
    font-variation-settings: 'opsz' 48;
    max-width: 28ch;
  }

  .about-body {
    display: grid;
    gap: 3rem;
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .about-prose {
    font-size: clamp(1.1rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .focus {
    align-self: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .focus-title {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .path {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    counter-reset: path;
  }

  .path li {
    counter-increment: path;
    display: grid;
    gap: 0.2rem;
    padding-left: 2.4rem;
    position: relative;
    line-height: 1.45;
  }

  .path li::before {
    content: counter(path);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ai);
    color: #fff;
    font: 600 0.85rem var(--sans);
  }

  .path strong,
  .pillars strong {
    font-family: var(--sans);
    font-weight: 600;
  }

  .path span {
    color: var(--stone);
    font-size: 1rem;
  }

  .pillars {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pillars li {
    display: grid;
    gap: 0.4rem;
    padding: 1.4rem 1.5rem;
    border-radius: 16px;
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    line-height: 1.5;
  }

  .pillars span {
    color: var(--stone);
  }

  .about-cta {
    margin-top: 2.5rem;
  }

  .cta-pill {
    display: inline-block;
    font: 600 1rem var(--sans);
    color: #fff;
    background: var(--ai);
    border-radius: 999px;
    padding: 0.8rem 1.6rem;
    text-decoration: none;
  }

  .cta-pill:hover {
    background: var(--paper);
  }

  @media (min-width: 960px) {
    .about-body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: 4rem;
    }
  }
</style>
