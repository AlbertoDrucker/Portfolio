---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/ui';
import { about } from '../content/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = about[lang];
---

<Base lang={lang} slug="about" title={c.metaTitle} description={c.metaDescription}>
  <section class="page-hero wrap">
    <h1 class="page-title">{c.title}</h1>
    <p class="page-lead">{c.lead}</p>
  </section>

  <section class="wrap about-body">
    <div class="prose about-prose">
      {c.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="focus">
      <h2 class="focus-title">{c.pathTitle}</h2>
      <ol class="path">
        {c.path.map((x) => <li><strong>{x.title}</strong><span>{x.text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">{c.focusTitle}</h2>
      <ul class="pillars">
        {c.focus.map((f) => <li><strong>{f.title}</strong><span>{f.text}</span></li>)}
      </ul>
      <p class="about-cta"><a class="cta-pill" href="#contact">{c.cta}</a></p>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.028em;
    font-weight: 360;
    font-variation-settings: 'opsz' 72;
  }

  .page-lead {
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.25;
    font-variation-settings: 'opsz' 48;
    max-width: 28ch;
  }

  .about-body {
    display: grid;
    gap: 3rem;
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .about-prose {
    font-size: clamp(1.1rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .focus {
    align-self: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .focus-title {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .path {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    counter-reset: path;
  }

  .path li {
    counter-increment: path;
    display: grid;
    gap: 0.2rem;
    padding-left: 2.4rem;
    position: relative;
    line-height: 1.45;
  }

  .path li::before {
    content: counter(path);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ai);
    color: #fff;
    font: 600 0.85rem var(--sans);
  }

  .path strong,
  .pillars strong {
    font-family: var(--sans);
    font-weight: 600;
  }

  .path span {
    color: var(--stone);
    font-size: 1rem;
  }

  .pillars {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pillars li {
    display: grid;
    gap: 0.4rem;
    padding: 1.4rem 1.5rem;
    border-radius: 16px;
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    line-height: 1.5;
  }

  .pillars span {
    color: var(--stone);
  }

  .about-cta {
    margin-top: 2.5rem;
  }

  .cta-pill {
    display: inline-block;
    font: 600 1rem var(--sans);
    color: #fff;
    background: var(--ai);
    border-radius: 999px;
    padding: 0.8rem 1.6rem;
    text-decoration: none;
  }

  .cta-pill:hover {
    background: var(--paper);
  }

  @media (min-width: 960px) {
    .about-body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: 4rem;
    }
  }
</style>
