---
import Base from '../layouts/Base.astro';
import Engine from '../components/Engine.astro';
import { findProject, labPage, labProjects } from '../content/lab';
import { localePath, type Lang } from '../i18n/ui';
import { home, work } from '../content/site';
import { scenarios } from '../content/engine';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang];
const w = work[lang];
const lab = labPage[lang];
const systems = c.systems.map((x) => ({ ...x, project: findProject(x.slug)! }));
const featured = c.featured.map((slug) => findProject(slug)!);
---

<Base lang={lang} slug="" title={c.metaTitle} description={c.metaDescription}>
  <section class="hero wrap">
    <h1 class="hero-title">
      {c.heroLines.map((line) => <span class="hero-line">{line}</span>)}
    </h1>
    <p class="hero-intro">{c.heroIntro}</p>
    <p class="hero-actions">
      <a class="hero-btn" href="#systems">{c.ctaBuilt}</a>
      <a class="hero-btn quiet" href="#contact">{c.ctaContact}</a>
    </p>
  </section>

  <section class="section" id="systems">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">{c.systemsTitle}</h2>
        <p class="section-lead">{c.systemsLead}</p>
      </div>
      <div class="systems">
        {
          systems.map((x) => (
            <a class="system-card" href={localePath(lang, `lab/${x.slug}`)}>
              <h3 class="system-title">{x.project.copy[lang].title}</h3>
              <p class="system-summary">{x.project.copy[lang].summary}</p>
              <ul class="system-points">
                {x.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <span class="system-open">{c.openDemo}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap engine-section">
      <div class="section-head">
        <h2 class="section-title">{c.engineTitle}</h2>
        <p class="section-lead">{c.engineIntro}</p>
      </div>
      <Engine lang={lang} scenarios={scenarios} uid="home" />
      <p class="engine-more"><a class="text-link" href={localePath(lang, 'how-i-work')}>{c.methodLink}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">{c.toolsTitle}</h2>
        <p class="section-lead">{c.toolsLead}</p>
      </div>
      <ul class="tool-cards">
        {
          featured.map((p) => (
            <li>
              <a class="tool-card" href={localePath(lang, `lab/${p.slug}`)}>
                <span class="tool-card-cat">{lab.categories[p.category]}</span>
                <span class="tool-card-title">{p.copy[lang].title}</span>
                <span class="tool-card-summary">{p.copy[lang].summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="lab-more"><a class="text-link" href={localePath(lang, 'lab')}>{c.toolsLink.replace('{n}', String(labProjects.length))}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">{c.workTitle}</h2>
        <p class="section-lead">{c.workLead}</p>
      </div>
      <ul class="work-list">
        {
          w.stories.map((story) => (
            <li>
              <a class="work-row" href={`${localePath(lang, 'work')}#${story.id}`}>
                <span class="work-area">{story.area}</span>
                <span class="work-title">{story.title}</span>
                <span class="work-summary">{story.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap about-teaser">
      <h2 class="section-title">{c.aboutTitle}</h2>
      <div>
        <p class="about-text">{c.aboutTeaser}</p>
        <p class="about-more"><a class="text-link" href={localePath(lang, 'about')}>{c.aboutLink}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3.5rem, 10vw, 8.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero-title {
    font-size: var(--step-hero);
    line-height: 0.96;
    letter-spacing: -0.03em;
    font-weight: 360;
    font-variation-settings: 'opsz' 72;
  }

  .hero-line {
    display: block;
  }

  /* The headline follows the site's color code: the AI line is blue. */
  .hero-line + .hero-line {
    color: var(--ai);
  }

  @media (min-width: 900px) {
    .hero-line + .hero-line {
      padding-left: 1.2em;
    }
  }

  .hero-intro {
    margin-top: clamp(2rem, 4vw, 3.25rem);
    max-width: 50ch;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--paper);
  }

  @media (min-width: 900px) {
    .hero-intro {
      margin-left: calc(var(--step-hero) * 1.2);
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .hero-actions {
      margin-left: calc(var(--step-hero) * 1.2);
    }
  }

  .hero-btn {
    font: 600 1rem var(--sans);
    text-decoration: none;
    color: #fff;
    background: var(--ai);
    border: 1px solid var(--ai);
    border-radius: 999px;
    padding: 0.8rem 1.5rem;
  }

  .hero-btn:hover {
    background: var(--paper);
    border-color: var(--paper);
  }

  .hero-btn.quiet {
    background: transparent;
    color: var(--paper);
    border-color: var(--rule-strong);
  }

  .hero-btn.quiet:hover {
    border-color: var(--paper);
  }

  .systems {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 860px) {
    .systems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .system-card {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 20px;
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    box-shadow: var(--lift);
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .system-card:hover {
    border-color: var(--ai);
  }

  .system-title {
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48;
  }

  .system-summary {
    color: var(--stone);
  }

  .system-points {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.98rem;
  }

  .system-points li {
    padding-left: 1rem;
    border-left: 3px solid var(--judgment-mark);
    line-height: 1.4;
  }

  .system-open {
    justify-self: start;
    margin-top: 0.5rem;
    font: 600 0.98rem var(--sans);
    color: #fff;
    background: var(--ai);
    border-radius: 999px;
    padding: 0.65rem 1.3rem;
  }

  .tool-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .tool-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1020px) {
    .tool-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tool-card {
    height: 100%;
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 1.4rem 1.5rem;
    border-radius: 16px;
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .tool-card:hover {
    border-color: var(--ai);
  }

  .tool-card-cat {
    font: 500 0.82rem var(--sans);
    color: var(--ai);
  }

  .tool-card-title {
    font-size: var(--step-1);
    line-height: 1.2;
    font-variation-settings: 'opsz' 36;
  }

  .tool-card-summary {
    color: var(--stone);
    font-size: 1rem;
    line-height: 1.5;
  }

  .engine-more {
    margin-top: 1.25rem;
  }

  .lab-more {
    margin-top: 2rem;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .work-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .work-area {
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--stone);
  }

  .work-title {
    font-size: var(--step-1);
    line-height: 1.2;
    font-variation-settings: 'opsz' 48;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 150ms ease;
  }

  .work-row:hover .work-title {
    text-decoration-color: var(--paper);
  }

  .work-summary {
    color: var(--stone);
    max-width: 60ch;
  }

  @media (min-width: 900px) {
    .work-row {
      grid-template-columns: 9rem minmax(0, 1.2fr) minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: baseline;
    }
  }

  .about-teaser {
    display: grid;
    gap: 1.5rem;
  }

  .about-text {
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.4;
    max-width: 38ch;
    font-variation-settings: 'opsz' 36;
  }

  .about-more {
    margin-top: 1.25rem;
  }

  @media (min-width: 900px) {
    .about-teaser {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: 2.5rem;
    }
  }
</style>
