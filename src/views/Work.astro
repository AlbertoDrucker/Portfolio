---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { type Lang } from '../i18n/ui';
import { work } from '../content/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = work[lang];
---

<Base lang={lang} slug="work" title={c.metaTitle} description={c.metaDescription}>
  <section class="page-hero wrap">
    <h1 class="page-title">{c.title}</h1>
    <p class="page-intro">{c.lead}</p>
  </section>

  <div class="wrap">
  <ul class="work-grid">
    {
      c.stories.map((story, i) => (
        <li class={i === 0 ? 'is-wide' : undefined}>
          <WorkCard lang={lang} story={story} />
        </li>
      ))
    }
  </ul>
  </div>
</Base>

<style>
  .page-hero {
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.028em;
    font-weight: 360;
    font-variation-settings: 'opsz' 72;
  }

  .page-intro {
    max-width: 52ch;
    color: var(--stone);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
  }

  .work-grid {
    list-style: none;
    padding: 0;
    margin: 0 auto clamp(4rem, 8vw, 6rem);
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  @media (min-width: 760px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }
    .work-grid .is-wide {
      grid-column: 1 / -1;
    }
    .work-grid .is-wide :global(.wcard-visual) {
      aspect-ratio: 21 / 8;
    }
  }
</style>
